# Database Configuration
DB_NAME=labtech
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Backend Configuration
NODE_ENV=production
BACKEND_PORT=3000
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# Encryption Configuration
ENCRYPTION_KEY=your_encryption_key_here_32_chars

# MFA Configuration
MFA_ISSUER=LabTech GeoLab

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Frontend Configuration
FRONTEND_PORT=8080
NGINX_HOST=localhost

# Nginx Proxy Configuration (Production)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Email Configuration (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@labtech.com

# AWS Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=labtech-backups

# Monitoring Configuration (Optional)
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_ENABLED=false
