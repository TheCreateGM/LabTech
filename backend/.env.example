# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
HTTPS_ENABLED=false
SSL_KEY_PATH=./keys/server-key.pem
SSL_CERT_PATH=./keys/server-cert.pem
SSL_CA_PATH=

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/labtech_geolab
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# JWT Configuration
JWT_ACCESS_SECRET=your-access-token-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Encryption Configuration
ENCRYPTION_KEY=your-32-character-encryption-key-change-this
ENCRYPTION_ALGORITHM=aes-256-gcm

# CORS Configuration
CORS_ORIGIN=http://localhost:8100,http://localhost:4200

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# File System Configuration
FILE_SCAN_PATH=../src
FILE_WATCH_ENABLED=true

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# MFA Configuration
MFA_ISSUER=LabTech GeoLab
MFA_WINDOW=1

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_EMAIL_ALERTS=false
BACKUP_EMAIL_RECIPIENTS=admin@example.com
BACKUP_SLACK_WEBHOOK=
BACKUP_STORAGE_THRESHOLD=80

# AWS Configuration (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring Configuration
SENTRY_DSN=
SENTRY_RELEASE=labtech-geolab@1.0.0
PROMETHEUS_ENABLED=true
